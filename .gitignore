node_modules/
.pnpm-store/
# NOTE: lib/ is intentionally tracked. Shipping the built output means a
# `dsh plugin add github:...` install needs no install-time script: pnpm 11
# blocks those by default, and a missing build leaves no lib/index.js to load.
# Re-run `pnpm build` and commit lib/ alongside any src change.
coverage/
*.log
.env
.DS_Store
.dsh-vision-router/

# 本地用的一次性/中间文件，不属于仓库内容
.ghtok
.gh-token.tmp
release-body.md
release-title.txt
.releases.json
.release-bodies.json
.m.txt
.cm.txt
NPM-FIRST-PUBLISH.md
*.tgz

# 待处理的截图暂存
.shot-*.png

# Local deployment backups of lib/ (never commit these)
_backup-lib-*/

# 补丁过程中的备份与临时脚本（不属于仓库内容）
*.bak-*
.patch-*/
